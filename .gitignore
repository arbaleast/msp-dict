# Python
__pycache__/
*.py[cod]
*.pyc
*.egg-info/
dist/
build/

# 构建产物 - MSPinyin DAT 词库文件
*.dat
# 例外：测试用的真实样本必须入库，否则单测依赖未跟踪文件
!tests/fixtures/*.dat
!tests/fixtures/*.scel

# 持久缓存：词源 / sogou / pytest / coverage（CI 与本地共用）
.cache/

# 本机凭据（如 crawler 的 SOGOU_COOKIE），绝不提交
.env

# 本机临时产物：msp_full.txt、dist/、scale_samples/ 等（随时可清）
.tmp/
new_words*.txt
crawl_output.txt

# IDE
.vscode/
.idea/
*.swp
*.swo

# 调试临时文件
_debug_*
_test_*
_tmp/

# 构建产物（CI 在仓库根生成、不提交）
msp_*.txt
msp_*.dat
build_summary.json
scale_samples/
